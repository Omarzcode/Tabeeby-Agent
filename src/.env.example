# ==============================================================================
# Tabeeby Agent — Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME=Tabeeby
APP_VERSION=1.0.0

# LLM Generation Configuration
# GEMINI | OPENAI | GROQ | OLLAMA
GENERATION_BACKEND=GEMINI
GENERATION_MODEL_ID=gemini-3.1-flash-lite
GENERATION_DAFAULT_MAX_TOKENS=1500
GENERATION_DAFAULT_TEMPERATURE=0.1
INPUT_DAFAULT_MAX_CHARACTERS=1000

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
OLLAMA_API_URL=http://localhost:11434

# Embedding Configuration
EMBEDDING_BACKEND=GEMINI
EMBEDDING_MODEL_ID=text-embedding-004
EMBEDDING_MODEL_SIZE=768

# Vector Database (Qdrant)
VECTOR_DB_BACKEND=QDRANT
VECTOR_DB_PATH=qdrant_db
VECTOR_DB_DISTANCE_METHOD=cosine
VECTOR_DB_COLLECTION_NAME=vezeeta_doctors
VECTOR_DB_URL=https://your-cluster-id.aws.cloud.qdrant.io
VECTOR_DB_API_KEY=your_qdrant_api_key_here

# Optional: Medical Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Production (FastAPI Cloud): https://<your-app>.fastapicloud.dev/telegram/webhook
# Local dev: leave empty and run `make telegram` (long polling) instead.
TELEGRAM_WEBHOOK_URL=https://your-app.fastapicloud.dev/telegram/webhook
# Any long random string; Telegram sends it back so only Telegram can call the webhook.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Agent loop budget per patient message ("a loop without a budget is a bug")
AGENT_MAX_STEPS=8
AGENT_MAX_SECONDS=90
AGENT_MAX_ACTIONS=12
# AGENT_MAX_COST_USD=0.01
AGENT_MAX_REFINEMENTS=2
AGENT_VERIFY=true
# USD per token for cost tracking — set these to your model's current list prices
INPUT_TOKEN_COST_USD=0.0000001
OUTPUT_TOKEN_COST_USD=0.0000004

# Skills (skills/*/SKILL.md)
SKILLS_ENABLED=true

# MCP: serve Tabeeby at /mcp, protected by a bearer key
MCP_SERVER_ENABLED=true
MCP_API_KEY=change_me_to_a_long_random_string
# Unlocks the usage & cost dashboard at /admin/usage
ADMIN_API_KEY=change_me_to_another_long_random_string
# Optional extra model prices, USD per 1M tokens: {"model": [input, cached_input, output]}
# MODEL_PRICES_JSON={"my-model": [1.0, 0.1, 4.0]}
# MCP: external servers whose tools the agent may borrow (JSON). Empty = none.
# MCP_SERVERS={"fetch": {"command": "uvx", "args": ["mcp-server-fetch"]}}
MCP_SERVERS=

# Conversation memory
SESSION_MAX_TURNS=10
SESSION_TTL_SECONDS=21600
